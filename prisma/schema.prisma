generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                   String   @id @default(cuid())
  name                 String
  planTier             String   @default("free")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  scanCountThisMonth   Int      @default(0)
  scanCountResetAt     DateTime @default(now())
  monthlyScanLimit     Int      @default(25)
  // One-time-purchased scans (see scripts/stripe-setup.mjs's scan pack price)
  // that stack on top of whatever the plan allows — consumed only after the
  // plan's own limit is hit, and never expire.
  scanCreditBalance    Int      @default(0)
  createdAt            DateTime @default(now())

  // "Give a month, get a month" referral program (see src/lib/referral.ts).
  // referralCode: this org's own shareable code (roof-scout.org/r/<code>).
  // referredByOrgId: set at signup if this org used someone else's link.
  // referralRewardAppliedAt: null until the referred org's first paid
  // conversion — the moment BOTH orgs get their free month. Non-null makes
  // the reward idempotent against webhook retries/races.
  // pendingFreeMonthCredits: a free month owed to this org that couldn't be
  // applied yet because it had no active Stripe subscription at reward time
  // (e.g. the referrer is still on Free) — consumed at next checkout.
  referralCode            String    @unique
  referredByOrgId         String?
  referredBy              Organization?  @relation("Referrals", fields: [referredByOrgId], references: [id])
  referrals               Organization[] @relation("Referrals")
  referralRewardAppliedAt DateTime?
  pendingFreeMonthCredits Int       @default(0)

  memberships      Membership[]
  leads            Lead[]
  scans            ScanRecord[]
  territoryClaims  TerritoryClaim[]
}

// Apex-tier perk: claiming a ZIP code reserves it against every other org on
// RoofScout — the unique constraint on zipCode IS the exclusivity guarantee,
// enforced at claim time via src/lib/territory.ts. Note the honest scope:
// this reserves the ZIP as a claim, it doesn't (yet) fence off scans by ZIP
// boundary, since scan areas are arbitrary lat/lng boxes and we don't hold
// ZIP polygon geodata.
model TerritoryClaim {
  id        String   @id @default(cuid())
  zipCode   String   @unique
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  claimedAt DateTime @default(now())

  @@index([orgId])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String? // null for OAuth-only accounts (Google/Apple sign-in)
  name         String?
  createdAt    DateTime  @default(now())
  onboardedAt  DateTime?

  memberships Membership[]
}

model Membership {
  id     String @id @default(cuid())
  userId String
  orgId  String
  role   String @default("Owner") // "Owner" | "Admin" | "Member"

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

model ScanRecord {
  id        String   @id @default(cuid())
  orgId     String
  createdAt DateTime @default(now())
  label     String
  north     Float
  south     Float
  east      Float
  west      Float
  leadCount Int      @default(0)
  // "processing" | "complete" | "failed" — live scans run in the background
  // (see /api/scan) and start "processing"; demo/mock scans are created
  // already "complete" since they resolve synchronously.
  status    String   @default("complete")
  // Step-driven live scan progress (see src/app/api/scan/[id]/route.ts).
  // Serverless function invocations get killed on their platform's timeout,
  // so a live scan can't just run to completion in one background call —
  // instead each poll from the client processes one small chunk of
  // `pendingBuildings` and persists progress here, so no single request ever
  // has to run long enough to hit a timeout. buildingsFetched flips true
  // once the initial OSM building lookup has succeeded; pendingBuildings is
  // the JSON-encoded BuildingCandidate[] still left to analyze (null once
  // discovery hasn't run yet, or once the scan is done).
  buildingsFetched Boolean @default(false)
  pendingBuildings String?
  totalBuildings   Int     @default(0)

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leads Lead[]

  @@index([orgId])
}

model Lead {
  id        String   @id @default(cuid())
  orgId     String
  scanId    String
  createdAt DateTime @default(now())

  address String
  city    String
  state   String
  zip     String
  lat     Float
  lng     Float

  ownerName          String?
  ownerPhone         String?
  ownerEmail         String?
  ownerYearsOwned    Int?
  ownerAssessedValue Int?

  roofAreaSqFt    Int
  roofPitch       String
  roofMaterial    String
  roofEstAgeYears Int
  roofSegments    Int

  conditionScore   Int
  conditionLabel   String
  conditionIssues  String // JSON-encoded string[]
  conditionSummary String
  conditionGraded  Boolean

  salesAngles String // JSON-encoded string[]
  status      String  @default("New")
  imageUrl    String?
  source      String?

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scan ScanRecord   @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([scanId])
}

// Failed login attempts only — successful logins never write a row. Checked
// (and opportunistically pruned) in src/lib/rateLimit.ts to throttle
// brute-force password guessing per-email and per-IP.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}
